PORT=3000
JWT_SECRET=change_this_to_random_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# رابط الاتصال بقاعدة بيانات MongoDB Atlas — إلزامي، الخادم لن يبدأ بدونه.
# احصل عليه من: MongoDB Atlas > Connect > Drivers > Node.js
# مثال: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URI=

# نطاقات مسموح لها بطلبات متصفح مباشرة (CORS) — مفصولة بفواصل، مثال:
# https://example.com,https://app.example.com
# اتركه فارغاً إذا لا يوجد أي واجهة أمامية منفصلة تستدعي هذا الخادم من
# متصفح مباشرة (لوحة التحكم نفسها من نفس الأصل ولا تحتاج هذا الإعداد،
# وروابط /client/* يستدعيها خادم Softora مباشرة وليس متصفحاً)
ALLOWED_ORIGINS=

# لجلب مستخدمي موقع Softora بنموذج إنشاء الترخيص (اختياري) — لازم تضبط
# SOFTORA_ADMIN_KEY بنفس القيمة المضبوطة بمتغيّر ADMIN_SECRET بموقع Softora
# بالضبط، وإلا الرفض يصير صامتاً وتفضل القائمة فاضية من مستخدمي الموقع
SOFTORA_URL=https://softora-website.onrender.com
SOFTORA_ADMIN_KEY=
